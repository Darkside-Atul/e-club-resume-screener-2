# Vercel project environment: Production
# Hosted Supabase project URL and publishable key from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Use a hosted Supabase secret key.
SUPABASE_SECRET_KEY=
# Exact HTTPS origin assigned to the production deployment, without a path.
APP_URL=
AUTHORIZED_EMAIL_DOMAIN=ashoka.edu.in
GOOGLE_OAUTH_ENABLED=false
MAX_RESUME_MB=10
APPLICATION_RETENTION_DAYS=180
# Generate a fresh production value. Put the same value in Supabase Vault.
CRON_SECRET=

# Start with manual review. Enable synthetic only after the approved test project
# and PDF hash are set and the Gemini key is stored in Production.
AI_SCREENING_MODE=off
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
GEMINI_SYNTHETIC_API_KEY=
AI_SYNTHETIC_PROJECT_ID=
AI_SYNTHETIC_PDF_SHA256=
AI_REQUESTS_PER_MINUTE=2
AI_REQUESTS_PER_DAY=20

# Reserved until a private provider is approved.
AI_PRIVATE_DATA_APPROVED=false
GEMINI_API_KEY=
# Legacy alias; prefer GEMINI_API_KEY.
GEMINI_PRIVATE_API_KEY=
OLLAMA_URL=
OLLAMA_BEARER_TOKEN=

# Read-only sample pages. Disables all real backend access when true.
DEMO_MODE=false
