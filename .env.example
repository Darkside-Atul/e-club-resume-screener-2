# Supabase Dashboard → Connect / API Keys. The publishable key is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret API key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SECRET_KEY=
# Must match private.settings.authorized_domain in Supabase.
AUTHORIZED_EMAIL_DOMAIN=ashoka.edu.in
# Direct Google OAuth callback: <app-origin>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Set the same or a larger file limit on the private Supabase bucket.
MAX_RESUME_MB=10
# Deletes application records and resumes this long after project deadline.
APPLICATION_RETENTION_DAYS=180
# off | synthetic | private. See README before enabling.
AI_SCREENING_MODE=off
# gemini | ollama
AI_PROVIDER=gemini
GEMINI_SYNTHETIC_API_KEY=
GEMINI_API_KEY=
# Legacy alias; prefer GEMINI_API_KEY.
GEMINI_PRIVATE_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_SYNTHETIC_PROJECT_ID=
AI_SYNTHETIC_PDF_SHA256=
AI_PRIVATE_DATA_APPROVED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BEARER_TOKEN=
AI_REQUESTS_PER_MINUTE=2
AI_REQUESTS_PER_DAY=20
# Generate with openssl rand -hex 32. Store the same value in Supabase Vault.
CRON_SECRET=

# Read-only sample pages. Disables all real backend access when true.
DEMO_MODE=false
